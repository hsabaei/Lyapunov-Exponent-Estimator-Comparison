{
  "experiment": "nonlinear repeated-root Newton runtime benchmark",
  "function_family": "(x-2)^m (x^2+1)",
  "multiplicities": [
    2,
    3,
    5
  ],
  "lambda_inf": "log((m-1)/m)",
  "windows": [
    10,
    20,
    40,
    50
  ],
  "paper_aligned_K_values": [
    10,
    20
  ],
  "replicates": 10,
  "seed": 2026,
  "cutoff": "1e-6",
  "trajectory_precision_dps": 220,
  "estimator_numeric_representation": "float64",
  "normalization": "(x_i - x_last) / max_j |x_j - x_last|, computed in mpmath before float64 conversion",
  "same_selected_windows_as_accuracy_experiment": true,
  "warmup": "one unreported call per estimator",
  "timed_region": "estimator call only",
  "excluded_from_timing": [
    "trajectory generation",
    "cutoff selection",
    "reference calculation",
    "normalization",
    "float64 conversion",
    "CSV writing"
  ],
  "primary_runtime_statistic": "median",
  "python": "3.12.2",
  "numpy": "1.26.4",
  "mpmath": "1.3.0"
}